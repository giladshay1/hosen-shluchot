games","name":"משחקי אדמה","audience":"ילדים מגיל 3, הורים וילדים","timing":"מלחמה, פינוי ואזעקות","phases":["ongoing"],"source":"KATALOG"},{"id":"svc_parenting6","name":"הורות ב-6 ערוצים / הורות כמסר","audience":"הורים לילדים 4–10 / 12–17","timing":"שגרת חירום והתאוששות","phases":["ongoing","recovery"],"source":"KATALOG"},{"id":"svc_resilience6","name":"חוסן ב-6 ערוצים / זקנה ב-6 ערוצים","audience":"מבוגרים / 62+","timing":"שגרה והתאוששות","phases":["recovery"],"source":"KATALOG"},{"id":"svc_reservist_groups","name":"קבוצות לבנות ובני זוג של מגויסים ולאמהות","audience":"משפחות מגויסים","timing":"מתמשך","phases":["ongoing"],"notes":"לפי קריטריון \"תושבים מגויסים\"","source":"KRIT"},{"id":"svc_save_savior","name":"מי יציל את המציל / איכות חיים מקצועית","audience":"עו\"סים, צוותי חינוך וטיפול","timing":"אחרי אירוע ומתמשך","phases":["ongoing","recovery"],"source":"KATALOG; MCHL25"},{"id":"svc_welfare_resilience","name":"חוסן רשותי לעובדי הרווחה","audience":"צוותי הרווחה","timing":"שגרה וחירום","phases":["ongoing","recovery"],"source":"KATALOG"},{"id":"svc_emergency_mgmt","name":"ניהול חירום והערכת מצב","audience":"רשויות, צח\"י","timing":"שגרה ושיקום","phases":["recovery"],"source":"KATALOG"},{"id":"svc_org_procedures","name":"נהלי חירום לארגונים","audience":"מכלולי חירום ברשויות","timing":"שיקום ושגרה","phases":["recovery"],"source":"KATALOG"},{"id":"svc_neemanim","name":"נאמני חוסן (זמן יקר)","audience":"תושבים מתנדבים","timing":"שגרה ולקראת חירום","phases":["recovery"],"notes":"תנאי: פגישה עם הרשות, גורם מפעיל ונוהל הפעלה. לא במועצות אזוריות עם צח\"י","source":"KATALOG; ZMANYAKAR"},{"id":"svc_tzachi_training","name":"הכשרת צח\"י / צח\"ש","audience":"בעלי תפקידים ופעילים","timing":"שגרה","phases":["recovery"],"source":"KATALOG"},{"id":"svc_bitter_news_training","name":"הכשרת בשורה מרה","audience":"עו\"סים וצוותי בתי חולים","timing":"שגרה","phases":["recovery"],"source":"KATALOG"},{"id":"svc_way_back","name":"הדרך בה רציתי לשוב בחזרה","audience":"קהילות של יישובים מפונים","timing":"שיקום ושיבה","phases":["recovery"],"source":"KATALOG"},{"id":"svc_transition_rural","name":"ליווי שלב המעבר – מרחב כפרי","audience":"יישוב שחוזר מפינוי","timing":"חזרה","phases":["ongoing"],"notes":"מתחיל כשחלק מהתושבים חזרו","source":"MAAVAR"},{"id":"svc_galgal","name":"גלגל תנופה","audience":"מנהלים ובעלי תפקידים ברשות","timing":"חירום מתמשך ושלב ההתפכחות","phases":["ongoing"],"source":"GALGAL"},{"id":"svc_melavim","name":"מלווים","audience":"בני משפחה של מתמודדים","timing":"שגרה ושיקום","phases":["recovery"],"source":"KATALOG"},{"id":"svc_authority_forum","name":"פורום רשותי בליווי מרכז החוסן","audience":"בעלי תפקידים ברשות","timing":"אחרי אירוע","phases":["recovery"],"notes":"לקח אורט מעלות","source":"ORT26"}]